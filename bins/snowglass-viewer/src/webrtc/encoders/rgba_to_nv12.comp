#version 450

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) uniform sampler2D source_image;
layout(set = 0, binding = 1, r8) uniform writeonly image2D luma_image;
layout(set = 0, binding = 2, rg8) uniform writeonly image2D chroma_image;

vec3 rgb_at(ivec2 position, ivec2 extent) {
    return texelFetch(source_image, clamp(position, ivec2(0), extent - 1), 0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = textureSize(source_image, 0);
    if (any(greaterThanEqual(position, extent))) {
        return;
    }

    vec3 rgb = rgb_at(position, extent);
    float y = 16.0 / 255.0
        + dot(rgb, vec3(0.182586, 0.614231, 0.062007));
    imageStore(luma_image, position, vec4(clamp(y, 0.0, 1.0), 0.0, 0.0, 1.0));

    if ((position.x & 1) == 0 && (position.y & 1) == 0) {
        vec3 average = (
            rgb_at(position, extent)
            + rgb_at(position + ivec2(1, 0), extent)
            + rgb_at(position + ivec2(0, 1), extent)
            + rgb_at(position + ivec2(1, 1), extent)
        ) * 0.25;
        float cb = 0.5 + dot(average, vec3(-0.100644, -0.338572, 0.439216));
        float cr = 0.5 + dot(average, vec3(0.439216, -0.398942, -0.040274));
        imageStore(
            chroma_image,
            position / 2,
            vec4(clamp(cb, 0.0, 1.0), clamp(cr, 0.0, 1.0), 0.0, 1.0)
        );
    }
}
