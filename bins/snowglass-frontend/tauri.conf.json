{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snowglass",
  "version": "0.1.0",
  "identifier": "dev.snowglass.frontend",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Snowglass",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
